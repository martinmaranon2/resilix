# CrisisOS Switzerland - Environment Configuration Template
# Copy this file to .env and configure your secrets / environment overrides.
# DO NOT COMMIT YOUR REAL .env FILE TO VERSION CONTROL!

# ==============================================================================
# GEMINI AI AGENT CONFIGURATION
# ==============================================================================
# Google Gemini API key for multimodal reasoning and agent tool execution.
# Obtain at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# ==============================================================================
# EXTERNAL DATA PROVIDERS
# ==============================================================================
# Windy Webcams API Key (V3)
# Required for retrieving live webcam images and metadata around Zurich rivers/bridges.
# Obtain a free or paid webcam API key at: https://api.windy.com/webcams/docs
# If not provided, CrisisOS will gracefully fall back to synthetic placeholder imagery.
WINDY_API_KEY=your_windy_api_key_here

# opentransportdata.swiss API Key (ASTRA / FEDRO Road Traffic)
# Required for live DATEX II road closures, traffic disruptions, and congestion feeds.
# Obtain free key at: https://opentransportdata.swiss/en/register/
# If not provided, CrisisOS operates with simulated fallback incident data.
OTD_API_KEY=your_opentransportdata_api_key_here

# ==============================================================================
# RUNTIME & LOGGING OPTIONS (OPTIONAL)
# ==============================================================================
# Log level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# HTTP request timeout in seconds
CRISIS_HTTP_TIMEOUT=15
